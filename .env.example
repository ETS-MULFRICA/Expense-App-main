# Environment Variables for ExpenseNavigator

# Session Configuration
SESSION_SECRET=your-super-secret-session-key-here

# Storage Backend Configuration
# Set to 'true' to use Supabase, 'false' for in-memory storage
USE_SUPABASE=false

# Supabase Configuration (only needed if USE_SUPABASE=true)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here

# Database Configuration (if using direct PostgreSQL)
DATABASE_URL=postgresql://username:password@localhost:5432/expense_tracker

# --- Optional: Windows paths for PostgreSQL client tools ---
# If pg_dump/psql are not on PATH, set absolute paths here.
# Quote paths with spaces. Examples for PostgreSQL 16 default install:
# PG_DUMP_PATH="C:\\Program Files\\PostgreSQL\\16\\bin\\pg_dump.exe"
# PSQL_PATH="C:\\Program Files\\PostgreSQL\\16\\bin\\psql.exe"
# Leave unset if the tools are available on PATH.

# Development Settings
NODE_ENV=development
PORT=5000
